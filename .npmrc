# Pin the official registry for this project.
#
# The lockfile previously resolved all 443 packages through
# registry.npmmirror.com, a third-party mirror. Two consequences:
#
#   1. `npm audit` does not work — that mirror does not implement the security
#      advisory endpoint, so vulnerable dependencies go unreported.
#   2. CI and Vercel builds inherit the mirror from the lockfile's resolved
#      URLs, making deployment depend on infrastructure we do not control.
#
# Integrity hashes meant nothing could be silently substituted, but losing
# advisories is a real gap. A project-level .npmrc keeps this correct for
# anyone who clones the repo, regardless of their global npm config.
registry=https://registry.npmjs.org/

# Fail the install rather than silently proceeding if a tarball's checksum
# does not match what the lockfile recorded.
audit=true
fund=false
