# ---------------------------------------------------------------------------
# Copy to .env.local and fill in. Every one of these is OPTIONAL — the site
# builds and runs without them; features degrade gracefully.
# ---------------------------------------------------------------------------

# Canonical site URL (metadata, sitemap, OG images, robots Host).
# MUST match the host Vercel actually serves. The apex redirects to www, so
# this is the www form — setting it to the apex reintroduces a canonical
# mismatch, because the value overrides site.url at build time.
NEXT_PUBLIC_SITE_URL=https://www.gershon.one

# Resend — contact form delivery. Without it, submissions are logged only.
RESEND_API_KEY=
CONTACT_TO_EMAIL=gotinkorang@gmail.com
CONTACT_FROM_EMAIL=Portfolio <noreply@gershon.one>

# Reference requests — referee contact details, emailed only to visitors who
# pass Turnstile and give a working address (app/api/references). The repo is
# public, so the data lives ONLY here and in Vercel, never in source. Uses the
# Resend variables above; without them or this, requests return 503.
# Single-line JSON array, single-quoted:
# REFERENCES_CONTACTS='[{"name":"Jane Doe","role":"IT Manager","organisation":"Example Ltd","phone":"+233 20 000 0000","year":"2022","email":"optional@example.com"}]'
REFERENCES_CONTACTS=

# PostHog — product analytics. Without it, analytics calls are no-ops.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Supabase — reserved for future features (guestbook, view counts).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# GitHub — powers the live activity feed. A classic token with `public_repo`
# raises the rate limit; unauthenticated requests still work.
GITHUB_USERNAME=
GITHUB_TOKEN=

# Cal.com — booking link in the contact section. Either a full URL or just the
# handle, e.g. "gershon/30min". Without it the booking card is not rendered.
NEXT_PUBLIC_CAL_LINK=

# ---------------------------------------------------------------------------
# Cloudflare Turnstile — bot protection on the contact form.
# ---------------------------------------------------------------------------
# Widget: gershon.one  (sitekey 0x4AAAAAAD--g5iiVpNCZD1B)
#
# The sitekey is public and already defaulted in components/turnstile.tsx, so
# only the secret is required. Get it from the Cloudflare dashboard:
#   dash.cloudflare.com -> Turnstile -> gershon.one -> Settings
#
# Without TURNSTILE_SECRET the server skips verification and accepts
# submissions, so local development needs no setup. Set it in production.
TURNSTILE_SECRET=

# Optional override — only needed if the widget is ever replaced.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
